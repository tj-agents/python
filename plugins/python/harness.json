{
  "schema_version": 1,
  "plugin": "tj-agents/python",
  "source_roots": [
    ".agents/python"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "tj-agents",
        "repository": "tj-agents/marketplace"
      }
    ],
    "plugins": [
      "tj-agents/python",
      "tj-agents/base",
      "tj-agents/engineering"
    ],
    "hooks": [
      {
        "path": ".agents/python/utility/check/scripts/run_checks.py",
        "hosts": [
          "claude",
          "codex"
        ]
      }
    ],
    "permissions": {
      "claude_allow": [],
      "codex_prefix_rules": []
    }
  }
}
