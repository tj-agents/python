{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|exec_command|exec",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/.agents/python/utility/check/scripts/run_checks.py\" --hook",
            "commandWindows": "python -B \"${PLUGIN_ROOT}/.agents/python/utility/check/scripts/run_checks.py\" --hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
